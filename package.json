{
  "name": "thenoticeboard",
  "version": "0.1.0",
  "private": true,
  "description": "Verified notice board for Indian government, PSU and verified private recruitment notifications.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker": "tsx worker/index.ts",
    "scrape:once": "tsx worker/index.ts --scrape-once",
    "make-admin": "tsx scripts/make-admin.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "duck-duck-scrape": "^2.2.7",
    "googlethis": "^1.8.0",
    "jose": "^6.1.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.544.0",
    "next": "^15.5.3",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^2.1.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.2.2",
    "postcss": "^8.5.6",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
