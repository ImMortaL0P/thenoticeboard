# ---- Database ----
# MongoDB Atlas — switch database name as needed.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority"

# ---- Auth ----
# Long random string used to sign login sessions. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the site (used in Telegram messages and share links)
SITE_URL="http://localhost:3000"

# ---- Telegram alerts (optional) ----
# Create a bot with @BotFather, paste the token and the bot's username (without @)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# ---- AI extraction for scraped notices (optional, recommended) ----
# AI extraction falls back through available providers. 
# If all AIs fail or none are configured, it natively falls back to Rule-Based Extraction.

# OPTION 1: Google Gemini (Free generous tier available at aistudio.google.com)
GEMINI_API_KEY=""

# OPTION 2: Groq (Free fast inference tier available at console.groq.com)
GROQ_API_KEY=""

# OPTION 3: Anthropic & OpenAI (Paid/Standard)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ---- Scraper ----
SCRAPE_CRON="0 */3 * * *"          # every 3 hours
SCRAPE_MAX_NEW_PER_SOURCE="8"
SCRAPE_USER_AGENT="thenoticeboard-bot/1.0 (+https://thenoticeboard.in/about)"

# ---- First admin account (created by `npm run setup`) ----
ADMIN_EMAIL="admin@thenoticeboard.local"
ADMIN_PASSWORD="ChangeMe!2026"

# ============================================================================
# AI providers — extraction and verification
# ============================================================================
# Set any subset. The cascade skips providers with no key, so an empty value
# simply means "not configured". Nothing here is required for the site to run;
# without any key the rules-based extractor handles everything on its own.
#
# Free tiers, roughly by daily allowance:
#   groq       14,400/day   console.groq.com
#   cerebras   14,400/day   cloud.cerebras.ai
#   gemini      1,500/day   aistudio.google.com
#   mistral     1B tok/mo   console.mistral.ai
#   nvidia      40 RPM      build.nvidia.com
#   openrouter    200/day   openrouter.ai
#   github     50-150/day   github.com/marketplace/models
#   ovh        anonymous tier works with NO key; a key raises the limit
GEMINI_MODEL=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NVIDIA_API_KEY=
OVH_AI_TOKEN=
SAMBANOVA_API_KEY=
TOGETHER_API_KEY=
SCALEWAY_API_KEY=
HF_TOKEN=
COHERE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GITHUB_MODELS_TOKEN=
LLM7_API_KEY=

# Local model. LEAVE EMPTY ON RENDER — the worker runs in the cloud and cannot
# reach your laptop. Set it only in your own .env, and only when Ollama is
# installed: OLLAMA_HOST=http://localhost:11434
OLLAMA_HOST=
OLLAMA_MODEL=qwen2.5:7b-instruct

# Paid, optional. Left empty means "skip".
ANTHROPIC_MODEL=
OPENAI_MODEL=

# Cascade order. Extraction favours speed and cost; verification favours
# quality, so they are ordered differently. Ollama is last in both: unlimited
# and free, and therefore the right fallback once hosted allowances are spent.
EXTRACT_PROVIDERS=
VERIFY_PROVIDERS=

# ============================================================================
# Verification agent
# ============================================================================
# Auto-publish is OFF by default. Turn it on only once you have watched a few
# passes and trust the confidence scores; a wrong closing date on a published
# notice costs a candidate an application.
AUTO_PUBLISH=0
AUTO_PUBLISH_MIN_CONFIDENCE=85

# ============================================================================
# Date constraints — what counts as a current notice
# ============================================================================
NOTICE_MAX_DAYS_PAST=7        # closed longer ago than this, with no extension -> reject
NOTICE_HARD_EXPIRY_DAYS=15    # expired this long ago -> reject, extension or not
NOTICE_MAX_AGE_DAYS=180       # published more than ~6 months ago -> reject
NOTICE_MAX_DAYS_FUTURE=400    # closing date further out than this -> parse error

# ============================================================================
# Extraction tuning
# ============================================================================
RULES_TRUST_MIN=60            # rules confidence at or above this skips the model
MAX_PDF_INLINE_BYTES=4194304  # larger PDFs use local text instead of the model
EXTRACT_TIMEOUT_MS=60000
EXTRACT_BUDGET_MS=180000
SCRAPE_MAX_AGGREGATOR_HOPS=15
